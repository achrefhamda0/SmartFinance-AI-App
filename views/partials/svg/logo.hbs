{{!-- Marque SmartFinance AI : le SVG remplit son conteneur (convention du jeu
     d'icônes), la taille reste pilotée par la classe utilitaire du gabarit.
     L'identifiant du dégradé est généré par `uniqueId` : la marque apparaît
     plusieurs fois par page (en-tête, pied de page, panneau d'authentification)
     et deux `id` identiques rendraient le HTML invalide. --}}
{{#with (uniqueId "sfai-mark")}}
<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="{{this}}" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
      <stop stop-color="#34D399" />
      <stop offset="0.55" stop-color="#22D3EE" />
      <stop offset="1" stop-color="#7C6CF6" />
    </linearGradient>
  </defs>
  <rect x="1" y="1" width="30" height="30" rx="9" fill="url(#{{this}})" fill-opacity="0.14" stroke="url(#{{this}})" stroke-opacity="0.5" />
  <path d="M8 21.5 L13 15.5 L17 18.5 L24 10" stroke="url(#{{this}})" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
  <circle cx="24" cy="10" r="2.4" fill="#34D399" />
  <path d="M8 25 H24" stroke="url(#{{this}})" stroke-width="1.4" stroke-linecap="round" stroke-opacity="0.5" />
</svg>
{{/with}}