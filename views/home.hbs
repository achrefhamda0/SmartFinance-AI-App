<a class="skip-link" href="#contenu">Aller au contenu principal</a>

<!-- ============ Navigation ============ -->
<header data-nav class="fixed inset-x-0 top-0 z-50" data-state="top">
    <div class="container-shell flex h-18 items-center justify-between gap-6">

        <a href="/" class="flex items-center gap-2.5" aria-label="SmartFinance AI, accueil">
            <span class="flex h-9 w-9 shrink-0">{{> svg/logo}}</span>
            <span class="font-display text-lg font-semibold tracking-tight text-white">SmartFinance<span class="text-brand-300"> AI</span></span>
        </a>

        <nav class="hidden items-center gap-1 lg:flex" aria-label="Navigation principale">
            {{#each nav}}
                <a class="nav-link" href="{{href}}">{{label}}</a>
            {{/each}}
        </nav>

        <div class="flex items-center gap-2 sm:gap-3">

            <div class="locale-switcher hidden md:inline-flex" role="group" aria-label="Langue de l’interface">
                <button type="button" class="locale-switcher__item is-active" aria-pressed="true">FR</button>
                <button type="button" class="locale-switcher__item" aria-pressed="false">EN</button>
            </div>

            <a href="/connexion" class="btn-ghost btn-sm hidden px-3 sm:inline-flex">Connexion</a>
            <a href="/inscription" class="btn-primary btn-sm hidden px-4 md:inline-flex">
                Créer un compte
            </a>


        </div>

    </div>

    <div id="menu-mobile" data-menu class="hidden border-t border-white/5 lg:hidden">
        <nav class="container-shell flex flex-col gap-1 py-4" aria-label="Navigation mobile">
            {{#each nav}}
                <a class="nav-link nav-link--block" href="{{href}}">{{label}}</a>
            {{/each}}
            <div class="mt-3 flex flex-col gap-2">
                <a href="/connexion" class="btn-secondary btn-sm w-full">Connexion</a>
                <a href="/inscription" class="btn-primary btn-sm w-full">Créer un compte</a>
            </div>
        </nav>
    </div>
</header>

